{
    "functions": {
        "api/**/*": {
            "maxDuration": 60
        },
        "pages/api/**/*": {
            "maxDuration": 60
        },
        "src/pages/api/**/*": {
            "maxDuration": 60
        },
        ".next/server/pages/api/**/*": {
            "maxDuration": 60
        },
        "app/api/**/*": {
            "maxDuration": 60
        },
        ".next/server/app/api/**/*": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Connection",
                    "value": "keep-alive"
                }
            ]
        }
    ]
}