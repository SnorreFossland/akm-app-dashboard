{
    "functions": {
        "app/api/**/route.js": {
            "maxDuration": 60
        },
        "app/api/**/route.ts": {
            "maxDuration": 60
        },
        "src/app/api/**/route.js": {
            "maxDuration": 60
        },
        "src/app/synchronous/api/route.ts": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Connection",
                    "value": "keep-alive"
                }
            ]
        }
    ]
}